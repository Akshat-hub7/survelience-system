# Copy this file to `.env` (or set these variables in your system)
# and fill in your own values before running the application.

# Your mobile number in international format (OTP + alerts are sent here)
USER_MOBILE_NO=+91XXXXXXXXXX

# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Console -> Verify -> Service SID (for Twilio-managed OTP)
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console -> Messaging -> Services SID (for local OTP + alert SMS)
TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
